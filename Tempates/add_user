<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add User</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        h1 {
            text-align: center;
        }
        form {
            display: flex;
            flex-direction: column;
        }
        label {
            margin: 10px 0 5px;
        }
        input {
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        button {
            padding: 10px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        button:hover {
            background-color: #218838;
        }
        a {
            display: block;
            text-align: center;
            margin-top: 20px;
            text-decoration: none;
            color: #007bff;
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Add User</h1>

        <!-- Form to add user -->
        <form action="/add_user" method="POST">
            <label for="username">Username:</label>
            <input type="text" id="username" name="username" required>
            <button type="submit">Add User</button>
        </form>
        <a href="manager-home">Back to Main Page</a>
    </div>

    <!-- Hidden div to store the flash message -->
    <div id="flash-message" style="display:none;">
        {% with messages = get_flashed_messages(with_categories=false) %}
            {% if messages %}
                {{ messages[0] }}  <!-- This displays the first flash message only -->
            {% endif %}
        {% endwith %}
    </div>

    <script>
        // JavaScript function to display flash messages as popups
        window.onload = function() {
            // Get the flash message element
            var flashMessageElement = document.getElementById('flash-message');
            
            // Check if the flash-message element exists and has non-empty content
            if (flashMessageElement && flashMessageElement.innerText.trim() !== '') {
                // If there's a flash message, show it in an alert popup
                alert(flashMessageElement.innerText);
            }
        }
    </script>
    
</body>
</html>
